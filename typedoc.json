{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "out": "./docs",
  "readme": "./README.md",
  "name": "moonraker-client",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": ["source-order"],
  "categorizeByGroup": true,
  "navigationLinks": {
    "GitHub": "https://github.com/jhyland87/moonraker-client",
    "Moonraker API": "https://moonraker.readthedocs.io/en/latest/web_api/"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "blockTags": [
    "@source",
    "@param",
    "@returns",
    "@typeParam",
    "@template",
    "@throws",
    "@example",
    "@remarks",
    "@see",
    "@deprecated",
    "@experimental",
    "@beta",
    "@alpha",
    "@internal",
    "@public",
    "@private",
    "@protected",
    "@readonly",
    "@override",
    "@author",
    "@since",
    "@version",
    "@defaultValue",
    "@default",
    "@group",
    "@groupDescription",
    "@category",
    "@categoryDescription",
    "@module",
    "@packageDocumentation",
    "@includeExample"
  ],
  "plugin": [
    "typedoc-plugin-mark-react-functional-components",
    "typedoc-plugin-expand-object-like-types",
    "typedoc-plugin-rename-defaults",
    "typedoc-plugin-coverage",
    "typedoc-plugin-include-example",
    "typedoc-plugin-dt-links",
    "typedoc-plugin-mdn-links",
    "typedoc-plugin-missing-exports",
    "typedoc-plugin-not-exported",
    "typedoc-plugin-inline-sources"
  ],
  "coverageLabel": "documented",
  "coverageColor": "#4c1",
  "coverageOutputType": "all",
  "coverageOutputPath": "./docs/coverage.svg",
  "coverageSvgWidth": 160
}
