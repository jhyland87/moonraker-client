{
  "name": "@jhyland87/moonraker-client",
  "version": "2.0.0-alpha.0",
  "description": "TypeScript Moonraker JSON-RPC websocket client",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist docs coverage",
    "example": "node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.0",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-dt-links": "^2.0.54",
    "typedoc-plugin-expand-object-like-types": "^0.1.2",
    "typedoc-plugin-include-example": "^3.0.2",
    "typedoc-plugin-inline-sources": "^1.3.0",
    "typedoc-plugin-mark-react-functional-components": "^0.2.2",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.3",
    "typedoc-plugin-not-exported": "^0.1.6",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "license": "ISC"
}
